<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Documento padrão -->
    <defaultDocument>
      <files>
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- Reescrita de URL (requer o módulo "URL Rewrite" instalado) -->
    <rewrite>
      <rules>
        <rule name="Laravel Front Controller" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Se for arquivo real, não reescreve -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- Se for pasta real, não reescreve -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>

    <!-- Segurança básica -->
    <security>
      <requestFiltering>
        <!-- Bloqueia alguns arquivos sensíveis comuns -->
        <hiddenSegments>
          <add segment=".env" />
          <add segment="vendor" />
          <add segment="storage" />
          <add segment="bootstrap" />
          <add segment="app" />
          <add segment="config" />
          <add segment="database" />
          <add segment="resources" />
          <add segment="routes" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- (Opcional) Evita directory browsing -->
    <directoryBrowse enabled="false" />

  </system.webServer>
</configuration>